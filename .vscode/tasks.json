{
  // Ctrl+Shift+P →「Tasks: Run Task」（或選單「終端機」→「執行工作」）→「總選單」；程式在下方終端機面板執行，
  // 自動模式啟動時在面板裡輸入 y 確認。要停止：在面板按 Ctrl+C，或滑鼠甩到螢幕左上角。
  "version": "2.0.0",
  "tasks": [
    {
      "label": "總選單（麻將、大老二全部功能）",
      "type": "process",
      "command": "${workspaceFolder}/.venv-train/Scripts/python.exe",
      "args": ["start.py"],
      "options": { "cwd": "${workspaceFolder}", "env": { "PYTHONIOENCODING": "utf-8" } },
      "presentation": { "panel": "dedicated", "focus": true, "clear": true },
      "problemMatcher": []
    }
  ]
}
